# Production environment template for the VM deployment (docker-compose.prod.yml).
# Copy to .env.prod and fill in real values — never commit .env.prod itself
# (already covered by .gitignore's ".env*" — double-check before committing).
#
#   cp .env.prod.example .env.prod
#
# Replace <VM-HOST> below with the VM's actual hostname or IP on the corp
# VLAN (e.g. mmh-factorymap01 or 10.x.x.x) — whatever coworkers will type
# into their browser.

# ---- Ports published on the VM (only these two need a VLAN firewall rule) --
FRONTEND_PORT=8080
BACKEND_PORT=4000
# MSSQL is intentionally NOT configurable here — docker-compose.prod.yml
# never publishes it to the host. Do not add a "ports:" entry for it.

# ---- Database -----------------------------------------------------------
# MSSQL SA password policy: 8+ chars, at least 3 of [upper, lower, digit,
# symbol]. Generate one, don't hand-pick it.
MSSQL_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MSSQL_DATABASE=factorymap

# ---- Auth -----------------------------------------------------------------
# Generate with: openssl rand -hex 32   (or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=CHANGE_ME_RANDOM_64_HEX_CHARS

# ---- Origins ----------------------------------------------------------
# Must match exactly what's in the browser address bar (scheme + host + port).
CORS_ORIGIN=http://<VM-HOST>:8080
REACT_APP_API_URL=http://<VM-HOST>:4000/api
# Only needed if a feature builds absolute links back to the app (e.g. QR
# codes on asset labels); leave blank to default to window.location.origin.
REACT_APP_PUBLIC_BASE_URL=http://<VM-HOST>:8080

# ---- ITSM ------------------------------------------------------------------
# 'snapshot' = read from itsm_hardware_snapshot only, zero live ITSM calls —
# this is the only mode this deployment should run in (see docs/DEPLOYMENT.md
# for how the snapshot gets onto this VM). Do NOT switch to 'real' here —
# the VM has no Kerberos/SSO path to Alemba.
ITSM_MODE=snapshot

# ---- Email / Teams alerts (optional — leave blank to disable) -------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=factory-map@company.local
TEAMS_WEBHOOK_URL=

# ---- Nexthink NQL API (optional — leave blank to keep using CSV exports) ---
# Both halves come from the portal URL: https://<instance>.<region>.nexthink.cloud
# They build two DIFFERENT hosts — the token comes from <instance>-login.<region>,
# the data from <instance>.api.<region>. Region is one of us / eu / pac / meta.
NEXTHINK_INSTANCE=
NEXTHINK_REGION=eu
# Administration -> API credentials -> New OAuth client credentials, with the
# NQL API permission ticked. The secret is Secret-class: it belongs here and
# nowhere else — never in the repo, never in a ticket, never in a chat.
NEXTHINK_CLIENT_ID=
NEXTHINK_CLIENT_SECRET=
# Saved NQL queries flagged for API use, in the form #some_id. The API will not
# run a query sent from here, only one that exists in Nexthink — so the entity
# filter and the 91-day window are reviewed there, by someone with access.
NEXTHINK_DEVICES_QUERY_ID=
NEXTHINK_LOGINS_QUERY_ID=
