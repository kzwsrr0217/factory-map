# Production image: static CRA build served by nginx.
#
# frontend/Dockerfile (dev) runs the CRA dev server with live source mounts;
# this one produces the small, immutable image meant for the VM deployment
# (see docker-compose.prod.yml / docs/DEPLOYMENT.md). REACT_APP_* values are
# baked into the JS bundle at build time, so they're passed as build args, not
# runtime environment variables.

FROM node:18-alpine AS build
WORKDIR /app

COPY package*.json ./
# See frontend/Dockerfile for why strict-ssl is relaxed and npm is pinned —
# same corporate-proxy build environment.
RUN npm config set strict-ssl false \
 && npm install -g npm@10.9.2 \
 && npm install --include=dev --no-audit --no-fund

COPY . .

ARG REACT_APP_API_URL
ARG REACT_APP_PUBLIC_BASE_URL
ENV REACT_APP_API_URL=${REACT_APP_API_URL}
ENV REACT_APP_PUBLIC_BASE_URL=${REACT_APP_PUBLIC_BASE_URL}
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build /usr/share/nginx/html

EXPOSE 80

# 127.0.0.1, not `localhost`. nginx.conf listens on IPv4 only, and the base image's
# 10-listen-on-ipv6-by-default.sh refuses to add `listen [::]:80` to a conf it does not
# recognise as the packaged one — it says so in the container log. So musl resolves
# `localhost` to ::1, tries that first, and the check fails with "Connection refused"
# while the site itself serves perfectly through the published port. The container spent
# days reporting unhealthy for that reason alone.
#
# The listen directive is deliberately left alone: `listen [::]:80` stops nginx from
# starting at all where the kernel has no IPv6, which is exactly what that entrypoint
# script exists to avoid.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:80/ >/dev/null || exit 1
